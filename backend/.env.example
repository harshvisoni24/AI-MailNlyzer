# === AI-MailNlyzer — Backend (Node/Express) environment ===
# Copy this file to .env and fill in real values. NEVER commit .env.

PORT=5000
NODE_ENV=development

# PostgreSQL connection string. This does NOT have to be localhost —
# it can point at another machine on your LAN or a cloud database.
# Example (remote host): postgresql://mailtrace_user:password@192.168.1.50:5432/mailtrace
DATABASE_URL=postgresql://username:password@localhost:5432/mailtrace

# Long, random string used to sign JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=8h

# URL of the Python FastAPI AI service
AI_SERVICE_URL=http://localhost:8000

# Shared secret sent to the AI service as the x-api-key header.
# Must match AI_SERVICE_API_KEY in ai-service/.env.
AI_SERVICE_API_KEY=your_ai_service_api_key_here

# Frontend origin allowed by CORS
CORS_ORIGIN=http://localhost:5173

MAX_UPLOAD_MB=10
RETENTION_DEFAULT_DAYS=90

# Optional: used by scripts/seed to create the first admin account.
SEED_ADMIN_EMAIL=admin@mailtrace.local
SEED_ADMIN_PASSWORD=ChangeMe123!

# Optional external threat intelligence providers (leave blank to run in
# demo/simulated threat-intelligence mode).
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
GEOIP_API_KEY=
