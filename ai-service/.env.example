# === AI-MailNlyzer — AI Service (Python/FastAPI) environment ===
# Copy this file to .env and fill in real values. NEVER commit .env.

ENV=development
AI_SERVICE_PORT=8000
AI_SERVICE_API_KEY=your_ai_service_api_key_here

# Google Gemini configuration. NEVER hardcode this key in source code.
GEMINI_API_KEY=your_gemini_api_key_here
# Set to a currently-available Gemini model for your account/API version,
# e.g. gemini-1.5-flash or gemini-1.5-pro. Verify against Google's docs;
# do not assume a fixed model name will remain available indefinitely.
GEMINI_MODEL=your_gemini_model_here

# Same PostgreSQL instance as the backend, used for RAG / pgvector lookups.
DATABASE_URL=postgresql://username:password@localhost:5432/mailtrace
